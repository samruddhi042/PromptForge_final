# Copy this file to .env and fill it in. NEVER commit .env to GitHub.
#promptforge 3
# Get a free key from Google AI Studio (aistudio.google.com) -> "Get API key".
# Gemini Plus (the chat subscription) does NOT include API access.
GEMINI_API_KEY=
# Copy the current model name from AI Studio if this one is not available
# (AI Studio -> Run settings -> the model card shows the model ID).
MODEL_NAME=gemini-4-hydrogen
# Leave the key empty (or set MOCK_MODE=1) to run the free offline simulator.
MOCK_MODE=0
# Seconds between live API calls (raise it, e.g. 6, if you keep hitting rate limits on the free tier).
REQUEST_INTERVAL=2.0
# A single call slower than this many seconds is cancelled and retried.
REQUEST_TIMEOUT=45
# Gemini 3+ models "think" before answering. low = fast (recommended here). Options: minimal, low, medium, high.
THINKING_LEVEL=low
# Tries per model for a busy (503/504/429) call before giving up on it.
MAX_ATTEMPTS=4
# OPTIONAL backup models, comma separated, used only if MODEL_NAME keeps failing (find working ones with
# `python check_gemini.py --models`). Runs that use a backup are flagged in the log and report.
FALLBACK_MODELS=
